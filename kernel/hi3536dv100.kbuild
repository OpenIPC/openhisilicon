# hi3536dv100 SoC family build configuration
#
# Cortex-A7 NVR/DVR SoC (decode + VO/HDMI, no ISP, JPEG-only encoder),
# kernel 4.9.37. Everything the vendor SDK supplies as kernel source is
# mirrored verbatim from Hi3536D_V100R001C02SPC020 -> Hi3536DV100_SDK_V2.0.2.0,
# laid out as for hi3520dv200:
#
#   package/osal.tgz  osal/source/kernel   -> osal/hi3536dv100/          open_osal.ko
#                     osal/include         -> osal/hi3536dv100/include/
#   package/drv       sys_config           -> sys_config/hi3536dv100/    open_sys_config.ko
#                     wtdg                 -> wdt/hi3536dv100/           open_wdt.ko
#                     hisi-irda            -> ir/hi3536dv100/            open_hi_ir.ko
#                     cipher/{src,include} -> cipher/hi3536dv100/        open_hi_cipher.ko
#   package/mpp       extdrv/tlv320aic31   -> tlv320aic31/hi3536dv100/   open_tlv_320aic31.ko
#                     include (+ mkp/)     -> include/hi3536dv100/       (headers only)
#
#   package/mpp       ko/*.ko (closed)     -> obj/hi3536dv100/<mod>.o     open_<mod>.ko
#                                             + init/hi3536dv100/<mod>_init.c
#
# The MPP modules have no source, only finished .ko files: base, sys, vdec,
# vfmw, jpegd, tde, region, vgs, vpss, vou, hifb, hdmi, venc, chnl, jpege, the
# audio set (aio, ai, ao, aenc, adec) and hi_acodec. scripts/ko2obj.sh turns
# each into a relinkable object (init_module renamed, the SDK kernel's
# struct module and .modinfo set aside), and the wrapper in init/ gives it
# entry points, as for gk7206v100. They keep their EXPORT_SYMBOLs and
# module_params. They reach the kernel only through OSAL, which is why the
# relinked set loads on OpenIPC's kernel once OSAL is built from source.
# The SDK's hi_osal.ko and sys_config.ko are not relinked: both have source.
# To regenerate the objects, from the SDK's mpp/ko:
#
#   for f in hi3536dv100_*.ko hifb.ko hi_acodec.ko; do
#     m=${f%.ko}; m=${m#hi3536dv100_}; m=${m#hi_}
#     scripts/ko2obj.sh arm-openipc-linux-gnueabi-objcopy hi3536dv100 \
#       mpp/ko/$f kernel/obj/hi3536dv100/$m.o
#   done
#
# Not here, by design:
#   - libmpi and the other userspace libraries: closed, and they stay in
#     firmware's hisilicon-osdrv-hi3536dv100.
#   - mpp/sample, mpp/tools, component/hdmi/sample: userspace demos and debug
#     tools, out of scope as for hi3520dv200.
#   - the kernel patch, U-Boot, busybox and host tools under osdrv/: those
#     belong to OpenIPC/linux and the bootloader repos.
#
# The SDK's prebuilt hi_osal.ko is unusable on OpenIPC's kernel: built for
# HiSilicon's kernel config, its himedia devices register with no dev_t
# (struct device is laid out differently), so /dev/sys, /dev/rgn and the rest
# never appear. That is why OSAL has to come from source.
#
# The vendor Makefile builds cache-l1.S and hi_user.c into the same hi_osal.ko
# (CPU_TYPE != slave), so they are part of open_osal too.

DV100_OSAL_DIR = osal/hi3536dv100

ccflags-y += -I$(src)/$(DV100_OSAL_DIR)
ccflags-y += -I$(src)/$(DV100_OSAL_DIR)/include
ccflags-y += -I$(src)/$(DV100_OSAL_DIR)/himedia
ccflags-y += -DHICHIP=0x3536d100

$(PREFIX)osal-objs := \
	$(DV100_OSAL_DIR)/osal_vmalloc.o \
	$(DV100_OSAL_DIR)/osal_addr.o \
	$(DV100_OSAL_DIR)/osal.o \
	$(DV100_OSAL_DIR)/osal_atomic.o \
	$(DV100_OSAL_DIR)/osal_barrier.o \
	$(DV100_OSAL_DIR)/osal_cache.o \
	$(DV100_OSAL_DIR)/osal_debug.o \
	$(DV100_OSAL_DIR)/osal_device.o \
	$(DV100_OSAL_DIR)/osal_interrupt.o \
	$(DV100_OSAL_DIR)/osal_math.o \
	$(DV100_OSAL_DIR)/osal_mutex.o \
	$(DV100_OSAL_DIR)/osal_proc.o \
	$(DV100_OSAL_DIR)/osal_schedule.o \
	$(DV100_OSAL_DIR)/osal_semaphore.o \
	$(DV100_OSAL_DIR)/osal_spinlock.o \
	$(DV100_OSAL_DIR)/osal_string.o \
	$(DV100_OSAL_DIR)/osal_task.o \
	$(DV100_OSAL_DIR)/osal_timer.o \
	$(DV100_OSAL_DIR)/osal_wait.o \
	$(DV100_OSAL_DIR)/osal_workqueue.o \
	$(DV100_OSAL_DIR)/osal_notifier.o \
	$(DV100_OSAL_DIR)/osal_platform.o \
	$(DV100_OSAL_DIR)/osal_fileops.o \
	$(DV100_OSAL_DIR)/himedia/base.o \
	$(DV100_OSAL_DIR)/himedia/himedia.o \
	$(DV100_OSAL_DIR)/mmz/media-mem.o \
	$(DV100_OSAL_DIR)/mmz/mmz-userdev.o \
	$(DV100_OSAL_DIR)/hiuser/cache-l1.o \
	$(DV100_OSAL_DIR)/hiuser/hi_user.o
obj-m += $(PREFIX)osal.o

# --- sys_config: pinctrl state (mode=demo|sck) and audio codec clock ---
$(PREFIX)sys_config-objs := sys_config/hi3536dv100/sys_config.o
obj-m += $(PREFIX)sys_config.o

# --- Watchdog (vendor module name: wdt.ko) ---
$(PREFIX)wdt-objs := wdt/hi3536dv100/hi_wdt.o
obj-m += $(PREFIX)wdt.o

# --- IR receiver (vendor module name: hi_ir.ko) ---
$(PREFIX)hi_ir-objs := ir/hi3536dv100/hiir.o
obj-m += $(PREFIX)hi_ir.o

# --- Cipher engine (vendor module name: hi_cipher.ko) ---
# Its include/ carries its own hi_type.h, which differs from the MPP one, so
# the paths are given per object rather than added to ccflags-y. HI_XXXX is
# what the SDK's Makefile.param passes for silicon (HI_FPGA is FPGA only).
# hi_unf_cipher.c (userspace library) and test_cipher.c are mirrored but not
# part of the module, as in the vendor Makefile.
DV100_CIPHER_DIR = cipher/hi3536dv100
DV100_CIPHER_CFLAGS := -I$(src)/$(DV100_CIPHER_DIR) -I$(src)/$(DV100_CIPHER_DIR)/include -DHI_XXXX
CFLAGS_drv_cipher.o  := $(DV100_CIPHER_CFLAGS)
CFLAGS_hal_cipher.o  := $(DV100_CIPHER_CFLAGS)
CFLAGS_cipher_intf.o := $(DV100_CIPHER_CFLAGS)
$(PREFIX)hi_cipher-objs := \
	$(DV100_CIPHER_DIR)/drv_cipher.o \
	$(DV100_CIPHER_DIR)/hal_cipher.o \
	$(DV100_CIPHER_DIR)/cipher_intf.o
obj-m += $(PREFIX)hi_cipher.o

# --- TLV320AIC31 audio codec (vendor module name: tlv_320aic31.ko) ---
# The SDK builds it against the kernel I2C driver (HI_I2C) unless
# CONFIG_GPIO_I2C is set; the hi3536dv100 kernel has CONFIG_I2C_HIBVT.
CFLAGS_tlv320aic31.o := -DHI_I2C
$(PREFIX)tlv_320aic31-objs := tlv320aic31/hi3536dv100/tlv320aic31.o
obj-m += $(PREFIX)tlv_320aic31.o

# --- MPP modules (closed, relinked from the SDK's .ko) ---
DV100_BLOBS := base sys vdec vfmw jpegd tde region vgs vpss vou hifb hdmi \
	venc chnl jpege aio ai ao aenc adec acodec
$(foreach b,$(DV100_BLOBS),$(eval $(PREFIX)$(b)-objs := \
	obj/hi3536dv100/$(b).o init/hi3536dv100/$(b)_init.o))
obj-m += $(addprefix $(PREFIX),$(addsuffix .o,$(DV100_BLOBS)))
